/*
  Cache-Control: no-transform
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Content-Security-Policy: default-src 'none'; img-src 'self' data:; style-src 'self'; font-src 'self'; script-src 'none'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; upgrade-insecure-requests
https://obraven.pages.dev/*
  X-Robots-Tag: noindex
/feed.xml
  Content-Type: application/atom+xml; charset=utf-8
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/css/*
  Cache-Control: public, max-age=2592000
/assets/figures/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/assets/social/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/assets/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/assets/brand/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
